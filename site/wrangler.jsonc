{
	"name": "wisprduck",
	"main": "./src/worker.js",
	"compatibility_date": "2025-01-29",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		// wisprduck.com is a Cloudflare for SaaS custom hostname on stellar.buzz.
		// Its traffic matches the fallback-origin route, not the wisprduck.com/*
		// route. Never widen this to *stellar.buzz/*: that pattern takes over
		// every stellar.buzz Worker custom domain.
		{
			"pattern": "proxy-fallback.stellar.buzz/*",
			"zone_name": "stellar.buzz"
		},
		{
			"pattern": "wisprduck.com/*",
			"zone_name": "stellar.buzz"
		},
		{
			"pattern": "www.wisprduck.com/*",
			"zone_name": "stellar.buzz"
		}
	]
}
